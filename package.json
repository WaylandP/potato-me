{
  "name": "potato-me",
  "version": "0.8.1",
  "description": "Create a potato avatar with six body shapes, expressive faces, hairstyles, jewelry, props and stickers. Browser-based PNG export and share links, with zero runtime dependencies.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Wayland Pearce",
  "homepage": "https://potato-me.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaylandP/potato-me.git"
  },
  "bugs": {
    "url": "https://github.com/WaylandP/potato-me/issues"
  },
  "keywords": [
    "avatar-generator",
    "potato",
    "javascript",
    "canvas",
    "static-site",
    "profile-picture",
    "client-side"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test",
    "assets": "node scripts/thumbs.mjs",
    "hero": "node scripts/hero.mjs",
    "shot": "node scripts/shot.mjs",
    "audit": "node scripts/audit-project.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "audit:cohesion": "node scripts/audit-cohesion.mjs",
    "audit:shapes": "node scripts/audit-shapes.mjs",
    "audit:wrap": "node scripts/audit-wrap.mjs",
    "audit:attachments": "node scripts/audit-attachments.mjs",
    "audit:color-framing": "node scripts/audit-color-framing.mjs",
    "audit:grips": "node scripts/audit-grips.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
